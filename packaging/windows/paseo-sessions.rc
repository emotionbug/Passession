// Executable resources of paseo_sessions.exe, compiled by packages/gui/build.rs
// with embed-resource. The build passes the include directories
// packaging/desktop and packaging/windows, the unquoted PASEO_VERSION
// ("x.y.z[-beta.n]") and the numeric PASEO_VERSION_MAJOR/MINOR/PATCH/BUILD macros.
#pragma code_page(65001)
#include <winres.h>

#define PASEO_STRINGIFY_(value) #value
#define PASEO_STRINGIFY(value) PASEO_STRINGIFY_(value)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 ICON "icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "paseo-sessions.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PASEO_VERSION_MAJOR,PASEO_VERSION_MINOR,PASEO_VERSION_PATCH,PASEO_VERSION_BUILD
 PRODUCTVERSION PASEO_VERSION_MAJOR,PASEO_VERSION_MINOR,PASEO_VERSION_PATCH,PASEO_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Paseo\0"
            VALUE "FileDescription", "Paseo Sessions\0"
            VALUE "FileVersion", PASEO_STRINGIFY(PASEO_VERSION) "\0"
            VALUE "InternalName", "sh.paseo.sessions.desktop\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 sh.paseo. All rights reserved.\0"
            VALUE "OriginalFilename", "paseo_sessions.exe\0"
            VALUE "ProductName", "Paseo Sessions\0"
            VALUE "ProductVersion", PASEO_STRINGIFY(PASEO_VERSION) "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
