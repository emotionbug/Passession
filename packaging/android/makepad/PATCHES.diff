+    void requestHideTextActions() {
+        synchronized (textActionLock) {
+            requestedTextActionToken = 0;
+            long generation = ++textActionRequestGeneration;
+            textActionHandler.post(() -> {
+                synchronized (textActionLock) {
+                    if (generation != textActionRequestGeneration) return;
+                }
+                finishTextActions();
+            });
+        }
+    }
