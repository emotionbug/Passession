{
  "worktree": {
    "setup": ["cargo xtask maintenance seed-dev-state", "cargo xtask build-daemon"]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "cargo xtask dev daemon --watch"
    },
    "desktop": {
      "command": "cargo xtask dev app"
    },
    "ios": {
      "command": "cargo xtask dev app ios"
    },
    "android": {
      "command": "cargo xtask dev app android"
    },
    "typecheck": {
      "command": "cargo check --locked -p paseo-gui-core -p paseo-gui-platform -p paseo-gui --all-targets"
    }
  }
}
